<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Management System</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <div class="container">
            <h1>Employee Management System</h1>
            <nav>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/employees">Employees</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <div class="hero">
            <h2>Welcome to Employee Management</h2>
            <p>Effortlessly manage your employee records with our intuitive CRUD system.</p>
            <div class="buttons">
                <a href="/employees" class="btn">View Employees</a>
                <a href="/employees/add" class="btn btn-primary">Add Employee</a>
            </div>
        </div>

        <section class="features">
            <div class="feature-card">
                <h3>Create</h3>
                <p>Add new employee records quickly and easily.</p>
            </div>
            <div class="feature-card">
                <h3>Read</h3>
                <p>View all employees and detailed information.</p>
            </div>
            <div class="feature-card">
                <h3>Update</h3>
                <p>Update employee details with simple forms.</p>
            </div>
            <div class="feature-card">
                <h3>Delete</h3>
                <p>Remove employee records safely when needed.</p>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Employee Management System. All rights reserved.</p>
    </footer>
</body>
</html>
