<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Employee</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>Employee Management System</h1>
            <nav>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/employees">Employees</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <div class="form-container">
            <h2>Update Employee</h2>
            <!-- Method-override is used here -->
            <form action="/employees/edit/<%= employee.id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="name">Employee Name</label>
                    <input type="text" id="name" name="name" value="<%= employee.name %>" required>
                </div>
                <div class="form-group">
                    <label for="employee_code">Employee Code</label>
                    <input type="text" id="employee_code" name="employee_code" value="<%= employee.employee_code %>" required>
                </div>
                <div class="form-group">
                    <label for="salary">Salary</label>
                    <input type="number" id="salary" name="salary" value="<%= employee.salary %>" required>
                </div>
                <div class="form-buttons">
                    <button type="submit" class="btn btn-add">Update Employee</button>
                    <a href="/employees" class="btn btn-view">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Employee Management System. All rights reserved.</p>
    </footer>
</body>
</html>
