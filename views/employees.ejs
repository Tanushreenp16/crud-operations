<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employees List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>Employee Management System</h1>
            <nav>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/employees">Employees</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <div class="table-container">
            <h2>All Employees</h2>
            <a href="/employees/add" class="btn btn-add">Add New Employee</a>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Employee Code</th>
                        <th>Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (employees.length === 0) { %>
                        <tr>
                            <td colspan="5">No employees found.</td>
                        </tr>
                    <% } else { %>
                        <% employees.forEach(emp => { %>
                            <tr>
                                <td><%= emp.id %></td>
                                <td><%= emp.name %></td>
                                <td><%= emp.employee_code %></td>
                                <td>$<%= emp.salary %></td>
                                <td>
                                    <a href="/employees/edit/<%= emp.id %>" class="btn btn-edit">Edit</a>

                                    <a href="/employees/delete/<%= emp.id %>" class="btn btn-delete">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Employee Management System. All rights reserved.</p>
    </footer>
</body>
</html>
