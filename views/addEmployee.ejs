<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Employee</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>Employee Management System</h1>
            <nav>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/employees">Employees</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <div class="form-container">
            <h2>Add New Employee</h2>
            <form action="/employees" method="POST">
                <div class="form-group">
                    <label for="id">Employee ID</label>
                    <input type="number" id="id" name="id" placeholder="Enter Employee ID" required>
                </div>
                <div class="form-group">
                    <label for="name">Employee Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter Employee Name" required>
                </div>
                <div class="form-group">
                    <label for="employee_code">Employee Code</label>
                    <input type="text" id="employee_code" name="employee_code" placeholder="Enter Employee Code" required>
                </div>
                <div class="form-group">
                    <label for="salary">Salary</label>
                    <input type="number" id="salary" name="salary" placeholder="Enter Salary" required>
                </div>
                <div class="form-buttons">
                    <button type="submit" class="btn btn-add">Add Employee</button>
                    <a href="/employees" class="btn btn-view">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Employee Management System. All rights reserved.</p>
    </footer>
</body>
</html>
